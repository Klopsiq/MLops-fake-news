# Локальный Python подключается через порт компьютера.
DATABASE_URL=postgresql+asyncpg://app:local_dev_password@127.0.0.1:5433/fake_news
# Compose использует эти параметры и адрес db:5432 внутри своей сети.
POSTGRES_USER=app
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=fake_news
APP_VERSION=0.1.3
LOG_LEVEL=INFO
