# Для запуска Python/API на компьютере. Compose задаёт адреса контейнеров сам.
DATABASE_URL=postgresql+asyncpg://app:local_dev_password@127.0.0.1:5433/fake_news
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=fake-news-hw3
MODEL_NAME=fake-news-classifier
MODEL_ALIAS=champion
RABBITMQ_URL=amqp://app:local_rabbit_password@127.0.0.1:5672/
TASK_QUEUE=fake-news.tasks.v2
QUEUE_MAX_LENGTH=100
WORKER_CONCURRENCY=4
INFERENCE_DELAY_SECONDS=1
PUBLISH_TIMEOUT_SECONDS=2
RETRY_AFTER_SECONDS=2
GRACEFUL_TIMEOUT_SECONDS=30
